# Lambda Engine - engine source.

# ---------------------------------------------------------------------------
# Unreal project (src/) - generated output
# ---------------------------------------------------------------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
.vsconfig
*.sln
*.slnx
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Build/ holds generated files, but the exe icon is source and must be kept.
# Note: a file cannot be un-ignored if its parent directory is excluded, so exclude
# directory *contents* (with /*) rather than the directories themselves.
Build/*
!Build/Windows/
Build/Windows/*
!Build/Windows/Application.ico

# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Mod content: keep maps/materials/gameinfo.txt, but not the Valve VPKs.
# Those ship with Half-Life 2 / Source SDK Base 2013 - see gameinfo.txt for
# where they come from. Redistributing them here would be both huge and wrong.
# ---------------------------------------------------------------------------
*.vpk

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
*.suo
*.VC.db
*.VC.opendb
*.user
Thumbs.db
desktop.ini

__pycache__/
